 import numpy as np
 import torch
 
 
+# Compatibility exports required by the tactile-genesis task snapshot.
+def quat_mul(a: torch.Tensor, b: torch.Tensor) -> torch.Tensor:
+    """Hamilton product of unit wxyz quaternions: R(a) @ R(b)."""
+    return transform_quat_by_quat(b, a)
+
+
+def axis_angle_from_quat(quat: torch.Tensor) -> torch.Tensor:
+    """Shortest rotation vector of a wxyz quaternion, stable near identity."""
+    q = torch.nn.functional.normalize(quat, dim=-1)
+    q = torch.where(q[..., :1] < 0, -q, q)
+    sine = torch.linalg.vector_norm(q[..., 1:], dim=-1, keepdim=True)
+    angle = 2.0 * torch.atan2(sine, q[..., :1])
+    scale = torch.where(sine > 1e-6, angle / sine.clamp_min(1e-12), 2.0 + sine.square() / 3.0)
+    return q[..., 1:] * scale
+
+
+def quat_error_magnitude(a: torch.Tensor, b: torch.Tensor) -> torch.Tensor:
+    """Shortest angular separation in radians, invariant to quaternion sign."""
+    return torch.linalg.vector_norm(axis_angle_from_quat(quat_mul(a, inv_quat(b))), dim=-1)
+
